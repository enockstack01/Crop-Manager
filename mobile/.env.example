# Clerk publishable key (same instance as the web client)
EXPO_PUBLIC_CLERK_PUBLISHABLE_KEY=pk_test_xxx

# Base URL of the CropManager Express API, including the /api suffix.
# - Android emulator  -> http://10.0.2.2:5000/api
# - iOS simulator     -> http://localhost:5000/api
# - Physical device   -> http://<your-computer-LAN-ip>:5000/api
# - Production         -> https://api.yourdomain.com/api
EXPO_PUBLIC_API_URL=http://10.0.2.2:5000/api

# Origin used to turn a relative /uploads/... path into an absolute URL
# (usually EXPO_PUBLIC_API_URL without the trailing /api).
EXPO_PUBLIC_API_ORIGIN=http://10.0.2.2:5000
