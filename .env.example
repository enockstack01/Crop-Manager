# Copy this file to server/.env and client/.env (split as noted) and fill in real values.

# ---- server/.env ----
PORT=5000
NODE_ENV=development
CLIENT_ORIGIN=http://localhost:5173
MONGODB_URI=mongodb+srv://<user>:<password>@<cluster>/crop_production?retryWrites=true&w=majority
CLERK_PUBLISHABLE_KEY=pk_test_xxx
CLERK_SECRET_KEY=sk_test_xxx

# AI assistant (Anthropic). Leave the key empty and the AI screens say they are not set up yet.
ANTHROPIC_API_KEY=
# ANTHROPIC_MODEL=claude-sonnet-5-5
# AI_DAILY_LIMIT=40        requests per user per day (admins are not limited)

# ---- client/.env ----
VITE_CLERK_PUBLISHABLE_KEY=pk_test_xxx
VITE_API_URL=http://localhost:5000/api
