PORT=5000
NODE_ENV=development
CLIENT_ORIGIN=http://localhost:5173

# MongoDB Atlas connection string (include a database name, e.g. /crop_production)
MONGODB_URI=mongodb+srv://<user>:<password>@<cluster>/crop_production?retryWrites=true&w=majority

# Clerk (Dashboard -> API Keys)
CLERK_PUBLISHABLE_KEY=pk_test_xxx
CLERK_SECRET_KEY=sk_test_xxx

# Optional: force specific DNS resolvers if your network cannot resolve SRV records
# DNS_SERVERS=1.1.1.1,8.8.8.8

# Optional (non-production only): accept an `x-dev-user` header as the user id so
# integration tests / curl can hit the API without a browser session. Leave unset normally.
# ALLOW_DEV_AUTH=1
